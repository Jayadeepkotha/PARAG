# =============================================================================
# PERMISSION-AWARE RAG (PARAG) - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to `config/.env` and fill in your actual credentials.
# NOTE: Never commit your actual `config/.env` to version control!

# -----------------------------------------------------------------------------
# 1. GOOGLE CLOUD PLATFORM (GCP) CONFIGURATION
# -----------------------------------------------------------------------------
# Your Google Cloud Project ID (e.g. permission-aware-rag-123456)
GCP_PROJECT_ID=your-gcp-project-id

# Geographic location for GCS buckets (e.g. asia-south1, us-central1)
GCP_BUCKET_LOCATION=asia-south1

# Absolute or relative path to your GCP Admin Service Account JSON key file
GCP_ADMIN_KEY_PATH=config/your_gcp_service_account_key.json

# Numerical GCP Project Number (needed for Auth0 Workload Identity Federation)
GCP_PROJECT_NUMBER=123456789012

# GCP Workload Identity Pool and Provider IDs (Auth0 Federated Mode)
GCP_POOL_ID=auth0-pool
GCP_PROVIDER_ID=auth0-provider

# -----------------------------------------------------------------------------
# 2. AMAZON WEB SERVICES (AWS) CONFIGURATION
# -----------------------------------------------------------------------------
# Default AWS Region for S3 buckets and IAM evaluation (e.g. ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# AWS Admin IAM Credentials with S3 and IAM administration permissions
AWS_ADMIN_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
AWS_ADMIN_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# -----------------------------------------------------------------------------
# 3. LLM INFERENCE PROVIDERS
# -----------------------------------------------------------------------------
# Google Gemini API Key (Required for Grounded Synthesis: gemini-3.5-flash / flash-lite)
GOOGLE_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# OpenAI API Key (Optional fallback if using OpenAI models)
OPENAI_API_KEY=sk-proj-yourOpenAiApiKeyHere

# -----------------------------------------------------------------------------
# 4. IDENTITY PROVIDER (IdP) & AUTHENTICATION MODE
# -----------------------------------------------------------------------------
# Choose: "static" (Permanent IAM keys & Service Accounts) or "auth0" (OIDC + STS)
AUTH_MODE=static

# Auth0 Enterprise Identity Federation (Only required if AUTH_MODE=auth0)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=yourAuth0ClientId
AUTH0_CLIENT_SECRET=yourAuth0ClientSecret
AUTH0_ROLE_ARN=arn:aws:iam::123456789012:role/Corporate-RAG-Auth0-Role
AUTH0_DEFAULT_PASSWORD=StrongEnterprisePassword123!
